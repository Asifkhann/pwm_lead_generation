# Server
PORT=5050
NODE_ENV=development

# Comma separated list of origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign session tokens. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-change-me-2f8a1c94b7e3d05a6c1f9b2e4d8a7c3f
# How many days a login stays valid
SESSION_DAYS=7

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/perfect-web-metrix
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/perfect-web-metrix?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/perfect-web-metrix
