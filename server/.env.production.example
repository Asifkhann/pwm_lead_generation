# Production environment for leadgeneration.perfectwebmetrix.com
#
# On Namecheap shared hosting these are entered in
#   cPanel -> Setup Node.js App -> Environment variables
# rather than in a file. This file documents what must be set.

NODE_ENV=production

# Passenger supplies the port. Leave unset on cPanel.
# PORT=

# Where the built frontend sits, relative to the application root.
CLIENT_DIST_PATH=./public

# The public address of the site. Used for CORS.
CLIENT_ORIGIN=https://leadgeneration.perfectwebmetrix.com

# MongoDB Atlas connection string. Create a database user, allow the server's
# IP, then copy the string from Atlas -> Connect -> Drivers.
# Remember to put the database name before the "?".
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/perfect-web-metrix?retryWrites=true&w=majority

# Signs session cookies. Generate a fresh one and never reuse the dev value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How many days a login stays valid.
SESSION_DAYS=7
